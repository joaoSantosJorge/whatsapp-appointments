# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Model (claude-haiku-5-5 = fast/cheap, claude-opus-5-5 = smartest)
CLAUDE_MODEL=claude-haiku-5-5

# Google service account: path to the JSON key file (local)...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# ...or the full JSON contents in one variable (hosted, e.g. Railway)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Calendar ID (Google Calendar → Settings of the calendar → "Integrate calendar" → Calendar ID)
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

TIMEZONE=Europe/Lisbon

# Optional: only reply to these numbers (comma separated, digits with country code, e.g. 351912345678).
# Leave empty to reply to everyone who messages you.
ALLOWED_NUMBERS=

# Dashboard (activity, conversations, stats, replies on/off switch): set PORT to enable it locally,
# then open http://localhost:3000/?key=<ADMIN_KEY>. Railway sets PORT automatically.
PORT=3000
ADMIN_KEY=change-me
